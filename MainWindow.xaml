<Window x:Class="GameLoopTACPanel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TAC Panel • GameLoop" Height="760" Width="980" MinHeight="680" MinWidth="900" Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}" WindowStartupLocation="CenterScreen">
<Grid Margin="22">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Margin="0,0,0,18">
<TextBlock Text="TAC PANEL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
<TextBlock Text="GameLoop configuration inspector • Safe mode" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,3,0,0"/>
</StackPanel>
<Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,16">
<DockPanel>
<StackPanel>
<TextBlock x:Name="StatusTitle" Text="Not scanned yet" FontSize="16" FontWeight="SemiBold"/>
<TextBlock x:Name="StatusDetail" Text="Run a read-only scan to find your GameLoop installation and candidate settings files." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
</StackPanel>
<Button DockPanel.Dock="Right" Content="SCAN GAMELOOP" Click="Scan_Click" Margin="15,0,0,0" VerticalAlignment="Center"/>
</DockPanel>
</Border>
<Grid Grid.Row="2">
<Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.25*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,10,0">
<StackPanel>
<TextBlock Text="PANEL PRESETS" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
<TextBlock Text="Resolution (preference only until verified)" Foreground="{StaticResource TextMuted}"/>
<ComboBox x:Name="ResolutionBox" SelectedIndex="1"><ComboBoxItem Content="1280 × 720 (720p)"/><ComboBoxItem Content="1920 × 1080 (1080p)"/><ComboBoxItem Content="2560 × 1440 (2K)"/><ComboBoxItem Content="3840 × 2160 (4K)"/></ComboBox>
<TextBlock Text="Screen DPI (preference only until verified)" Foreground="{StaticResource TextMuted}"/>
<ComboBox x:Name="DpiBox" SelectedIndex="2"><ComboBoxItem Content="120"/><ComboBoxItem Content="160"/><ComboBoxItem Content="240"/><ComboBoxItem Content="280"/><ComboBoxItem Content="320"/><ComboBoxItem Content="480"/></ComboBox>
<TextBlock Text="Renderer" Foreground="{StaticResource TextMuted}"/>
<ComboBox x:Name="RendererBox" SelectedIndex="0"><ComboBoxItem Content="Auto (recommended)"/><ComboBoxItem Content="OpenGL+"/><ComboBoxItem Content="DirectX+"/><ComboBoxItem Content="Vulkan (verify support first)"/><ComboBoxItem Content="DirectX Lite (verify support first)"/></ComboBox>
<Button Content="SAVE PANEL PREFERENCES" Click="Save_Click" Margin="0,10,0,0"/>
<Border Background="#28251B" CornerRadius="7" Padding="10" Margin="0,12,0,0">
<TextBlock Text="Safety: presets are not applied to GameLoop until a version-specific config adapter is verified. This build will not fake an Apply success." Foreground="#F7D794" TextWrapping="Wrap"/>
</Border>
</StackPanel>
</Border>
<Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="10,0,0,0">
<StackPanel>
<TextBlock Text="DISCOVERY REPORT" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
<TextBlock Text="Installation candidates" Foreground="{StaticResource TextMuted}"/>
<ListBox x:Name="InstallList" Height="100" Background="#111722" Foreground="#E2E8F0" BorderBrush="#34445B" Margin="0,5,0,12"/>
<TextBlock Text="Potential settings files (read-only scan)" Foreground="{StaticResource TextMuted}"/>
<ListBox x:Name="ConfigList" Height="170" Background="#111722" Foreground="#E2E8F0" BorderBrush="#34445B" Margin="0,5,0,8"/>
<WrapPanel>
<Button Content="BACK UP SELECTED FILE" Click="Backup_Click"/>
<Button Content="OPEN REPORT FOLDER" Click="OpenFolder_Click"/>
</WrapPanel>
<TextBlock x:Name="ReportText" Text="No report yet." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
</StackPanel>
</Border>
</Grid>
<TextBlock Grid.Row="3" Text="v0.3 • Read-only discovery + backup scaffold • No hidden-key guessing" Foreground="{StaticResource TextMuted}" Margin="0,14,0,0"/>
</Grid>
</Window>
