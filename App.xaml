<Application x:Class="GameLoopTACPanel.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#10131B"/>
    <SolidColorBrush x:Key="Panel" Color="#191F2B"/>
    <SolidColorBrush x:Key="Accent" Color="#42D6A4"/>
    <SolidColorBrush x:Key="TextMain" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9AA8BB"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#263244"/><Setter Property="Foreground" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#34445B"/><Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,5,8,5"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#263244"/><Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,0,10"/>
    </Style>
  </Application.Resources>
</Application>
